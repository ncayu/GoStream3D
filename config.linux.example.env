# Linux 渲染节点：正式发布包自带 config.env，可直接运行 ./gostream3d --config config.env。
# 仅使用本示例时，复制为 config.env；网络地址按部署环境调整，Neko 内部密码需单独设置。
GOSTREAM3D_RUNTIME=native
# GoStream3D 管理后台和观看链接的监听端口，修改后重启生效；默认 8888。
GOSTREAM3D_HTTP_PORT=8888
# 监听 IP；0.0.0.0 允许其他设备访问，部署时请配置防火墙与访问控制。
GOSTREAM3D_HTTP_HOST=0.0.0.0
# 可选回退地址：观看链接默认跟随当前管理页访问地址，仅缺少请求 Host 时使用此值。
# GOSTREAM3D_PUBLIC_BASE_URL=http://192.168.1.100:8888
# 当前机器的管理后台账号密码。
GOSTREAM3D_ADMIN_USERNAME=admin
# 默认管理员密码；登录后可在右上角用户菜单修改账号密码。
GOSTREAM3D_ADMIN_PASSWORD=Admin@2026.com
# Optional for old API clients only: GOSTREAM3D_ADMIN_API_KEY=...
GOSTREAM3D_NEKO_USER_PASSWORD=replace-with-internal-user-secret
GOSTREAM3D_NEKO_ADMIN_PASSWORD=replace-with-internal-admin-secret
GOSTREAM3D_ICE_PUBLIC_IP=127.0.0.1
GOSTREAM3D_NEKO_BIN=neko
GOSTREAM3D_CHROMIUM_BIN=chromium
GOSTREAM3D_XORG_BIN=Xorg
GOSTREAM3D_PULSE_BIN=pulseaudio
GOSTREAM3D_VGLRUN_BIN=vglrun
GOSTREAM3D_WORK_ROOT=data/workers
GOSTREAM3D_SESSION_STORE=data/sessions.json
# 初始端口池共同配置为 3 路，并非 GPU 自动检测的最大值。
# 后台“渲染通道设置”可调总通道数 1–100，保存立即生效，channel-settings.json 重启后优先。
# 系统按原起始端口调整池末端；Linux 防火墙需允许调整后的实际 UDP 端口段。
# CPU/GPU 项目与预加载 Worker 共用此总配额，扩大值需实测服务器承载能力。
GOSTREAM3D_HTTP_PORTS=30000-30002
GOSTREAM3D_CDP_PORTS=31000-31002
GOSTREAM3D_UDP_PORTS=52000-52023
GOSTREAM3D_UDP_PER_WORKER=8
# 已发布项目在启动时自动预加载并持续保持就绪；设为 false 才按 IDLE_TIMEOUT 回收。
GOSTREAM3D_KEEP_PRELOADED=true
GOSTREAM3D_IDLE_TIMEOUT=180s
GOSTREAM3D_READY_TIMEOUT=300s
