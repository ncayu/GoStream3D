# Windows 本机渲染。程序在当前电脑启动 Edge、Chrome 或 Chromium；无需 Linux 地址。
GOSTREAM3D_RUNTIME=native

# 本机管理和观看入口。修改端口后重启软件；默认 8888。
GOSTREAM3D_HTTP_PORT=8888
# 默认允许局域网访问；仅本机使用时可改为 127.0.0.1。
GOSTREAM3D_HTTP_HOST=0.0.0.0

# 可选回退地址：观看链接默认跟随当前管理页访问地址，无需为局域网访问另行填写。
# GOSTREAM3D_PUBLIC_BASE_URL=http://192.168.1.100:8888

# 登录凭据统一在 config.env 中配置；修改后重启生效，密码至少 12 位。
# 正式发布包自带 config.env；单独 EXE 首次启动也使用下列初始账号密码。
GOSTREAM3D_ADMIN_USERNAME=admin
GOSTREAM3D_ADMIN_PASSWORD=Admin@2026.com

# 已发布项目在启动时自动预加载并持续保持就绪；设为 false 才按空闲时间回收。
GOSTREAM3D_KEEP_PRELOADED=true

# 本软件及其渲染浏览器的 CPU 硬上限（整机总能力的百分比）；默认 50%，0 表示关闭。
# 可在后台设置中调整 1–100%，保存后立即生效；平台 cpu-settings.json 中保存的值重启后优先。
GOSTREAM3D_CPU_MAX_PERCENT=50

# CPU 软件渲染后端，保持项目原分辨率；可比较两种后端在实际场景中的帧率。
# swiftshader（默认）或 warp（Windows WARP 软件光栅化，不使用显卡渲染）。
GOSTREAM3D_CPU_RENDERER=swiftshader
# original 保持原页面效果；simplified 关闭 CPU WebGL 抗锯齿，并简化 ThingJS 园区后期、阴影和描边。
# 原分辨率、模型、纹理及交互保留；GPU 模式不受影响。修改后重启生效。
GOSTREAM3D_CPU_EFFECTS=original

# 可选：指定本机浏览器路径，默认自动查找 Edge 或 Chrome。
# GOSTREAM3D_CHROMIUM_BIN=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# 可选：本机浏览器进程目录与初始端口池。默认三个端口池共同配置为 3 路，并非 GPU 自动检测。
# 后台“渲染通道设置”可调整总通道数 1–100，保存立即生效并在重启后优先恢复。
# 保存值位于会话数据目录的 channel-settings.json；系统按下列起始端口调整池末端。
# 项目多路配额可自定义 2–100、允许超过当前总配额；同时运行仍共用服务器总配额。
# 扩大配额不保证硬件流畅并发，额外实例在访问时按需启动。
# GOSTREAM3D_WORK_ROOT=data/workers
# GOSTREAM3D_CDP_PORTS=31000-31009
# GOSTREAM3D_HTTP_PORTS=30000-30009
# GOSTREAM3D_UDP_PORTS=52000-52079

# 当前 Windows native 使用 JPEG/WebSocket 画面传输，无音频；GPU 选择由本机浏览器决定。
