# Set the server IP reachable by viewers, or run bash start.sh for LAN auto-detection.
# For Internet/NAT viewers, set the public IP explicitly with --public-ip.
GOSTREAM3D_ICE_PUBLIC_IP=
GOSTREAM3D_HTTP_PORT=8888
# GPU selection for projects using "本机 GPU": auto, intel, nvidia.
GOSTREAM3D_GPU_BACKEND=auto
# Optional Intel device selection (default: detected Intel render device).
# GOSTREAM3D_GPU_RENDER_DEVICE=/dev/dri/renderD128
# Optional local paths; the default data directory is next to docker-compose.yml.
# GOSTREAM3D_DATA_DIR=/opt/gostream3d-docker/data
# GOSTREAM3D_DOCKER_SOCKET=/run/gostream3d-docker.sock
# sudo bash start.sh configures these automatically on systemd / cgroup v2:
# GOSTREAM3D_CGROUP_PARENT=gostream3d.slice
# GOSTREAM3D_CPU_CGROUP_DIR=/sys/fs/cgroup/gostream3d.slice
# GOSTREAM3D_CPU_CGROUP_PATH=/host/cpu/cpu.max
# NVIDIA monitoring (detected automatically when a GPU and runtime are present):
# GOSTREAM3D_GATEWAY_RUNTIME=nvidia
# GOSTREAM3D_GPU_LIBRARY_DIR=/usr/lib/wsl
